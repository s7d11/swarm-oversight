# Copy to .env (scripts/setup.sh does this) and fill in. .env is git-ignored.

# Adaption Labs API key, for the hosted models (https://adaptionlabs.ai)
ADAPTION_API_KEY=

# Optional: Hugging Face token with write access, only if you offload run records to your own dataset
# (SWARM_OFFLOAD=hf and SWARM_HF_REPO in swarm.local.conf; see README "Records")
HF_TOKEN=
