# /etc/default/llama-swarm: settings for both local LFM servers (installed by deploy/install_llama_services.sh).
# Edit, then: sudo systemctl restart llama-server-lfm3 llama-server
# NOTE: systemd EnvironmentFile has NO inline comments. Keep every comment on its own line,
# otherwise the comment text becomes part of the value (this broke the first install).
#
# Hardware (2026-11-07): RTX 3060 Laptop 6 GB (CUDA), Ryzen 9 5900HS 16 threads, WSL RAM 12 GB (.wslconfig).
# The Radeon iGPU is NOT reachable from WSL (Vulkan only sees llvmpipe), so offload for LFM2.5 means CPU.

LLAMA_BIN=/home/seb/src/llama.cpp/build/bin/llama-server

# ---- shared ----------------------------------------------------------------
# Same context for both models (one unified pool per server, see -kvu). Halved from 262144 on 2026-11-07.
# 131072 is 3072 tokens beyond LFM2.5's trained 128000 (LFM3 is trained to 262144).
CTX=131072
# KV cache precision: q8_0 is about 0.85 GB per model at 131072; q4_0 halves it.
KV_TYPE=q8_0
# Host-RAM prompt cache in MiB; llama-server's default (8192) would crowd WSL RAM.
CACHE_RAM_MIB=1024

# ---- LFM3-1.7B: fully on the CUDA GPU (about 3 GB VRAM at 131072) ------------
LFM3_MODEL=/mnt/c/Users/sebas/.lmstudio/models/lmstudio-community/LFM3-1.7B-GGUF/LFM3-1.7B-Q8_0.gguf
LFM3_PORT=18081
LFM3_SLOTS=2
LFM3_OFFLOAD=-ngl 99

# ---- LFM2.5-8B-A1B (Hermes): trained to 128000; llama.cpp caps its context there ----
# MoE experts on CPU; attention/dense layers AND the KV cache on CUDA (tested 2026-11-07: total VRAM with
# LFM3 = 4.9 of 6.1 GB; ~20% faster than "-nkvo", 19 vs 15 tok/s generation).
# Short of VRAM? add -nkvo (KV cache to CPU, ~0.8 GB less). More VRAM? "-ngl 99 --n-cpu-moe 20"
# keeps the experts of 4 layers on the GPU (~0.7 GB more) -- leave >= 0.5 GB free for the Windows desktop.
LFM25_MODEL=/home/seb/models/LFM2.5-8B-A1B-Q4_0.gguf
LFM25_PORT=18080
LFM25_SLOTS=2
LFM25_OFFLOAD=-ngl 99 --cpu-moe
# Optional RoPE stretch for contexts beyond 128000 (changes outputs at all lengths). Empty = off.
# Example: --rope-scaling yarn --rope-scale 1.024 --yarn-orig-ctx 128000
LFM25_ROPE=
