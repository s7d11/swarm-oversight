[Unit]
Description=llama.cpp server (LFM3-1.7B, 131072 ctx, CUDA) for Hermes agent + swarm experiments
After=network.target
Before=llama-server.service

[Service]
Type=simple
User=seb
Group=seb
EnvironmentFile=/etc/default/llama-swarm
ExecStart=/bin/sh -c 'exec "$LLAMA_BIN" -m "$LFM3_MODEL" --alias lfm3-1.7b --host 127.0.0.1 --port "$LFM3_PORT" --jinja -fa on -c "$CTX" -np "$LFM3_SLOTS" -kvu -ctk "$KV_TYPE" -ctv "$KV_TYPE" -cram "$CACHE_RAM_MIB" --load-mode none $LFM3_OFFLOAD'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
