# ---- secrets and machine-specific settings ----
.env
swarm.local.conf
*.pem
!keys/seal-public.pem
keys/*.local.pem

# ---- dependencies fetched and built by scripts/setup.sh ----
third_party/
models/
lib/*.so
lib/*.so.*
lib/*.bak-*
bin/

# ---- run records (kept on disk or offloaded to a dataset, never in git) ----
logs/
sealed/
report/
runs/

# ---- local tooling ----
.venv/
__pycache__/
.pytest_cache/
.claude/
*.pyc
*:Zone.Identifier

# ---- paper sources (kept locally, not published) ----
submission/
